# --- Instagram accounts -------------------------------------------------------
# Numbered accounts: _1, _2, _3 ... (gaps are fine). Each account needs its OWN proxy.
# IG_ROLE:  engagement = influencer profile, posts, likers, commenters
#          activity   = only the daily activity plan (warm-up for a new account); no collection
#           audience   = public profile + recent posts of each unique engager
#           both       = engagement first, then audience (default)
# Workers randomize turns among the least-used accounts of the required role.
# If audience work makes 400 Instagram calls, accounts 2-5 get about 100 each.
# Engagement work goes to account 1 because it is the only engagement account.
# IG_MAX_PER_DAY is optional; it overrides MAX_REQUESTS_PER_DAY for that account.
# Proxy formats: http://user:pass@host:port   or   socks5h://user:pass@host:port

IG_USERNAME_1=
IG_PASSWORD_1=
PROXY_URL_1=
IG_ROLE_1=engagement

IG_USERNAME_2=
IG_PASSWORD_2=
PROXY_URL_2=
IG_ROLE_2=audience

IG_USERNAME_3=
IG_PASSWORD_3=
PROXY_URL_3=
IG_ROLE_3=audience

IG_USERNAME_4=
IG_PASSWORD_4=
PROXY_URL_4=
IG_ROLE_4=audience

IG_USERNAME_5=
IG_PASSWORD_5=
PROXY_URL_5=
IG_ROLE_5=audience
# IG_MAX_PER_DAY_5=300

# Alternatives: accounts.json (see accounts.example.json) takes priority over the
# numbered accounts; a single unnumbered IG_USERNAME / IG_PASSWORD / PROXY_URL still works.
IG_USERNAME=
IG_PASSWORD=
PROXY_URL=

# Region the accounts normally use. Applied on each account's first login only,
# then kept in its saved session. Defaults: India.
IG_COUNTRY=IN
IG_COUNTRY_CODE=91
IG_LOCALE=en_IN
IG_TIMEZONE_OFFSET=19800

# --- Storage ------------------------------------------------------------------
# MongoDB Atlas connection string, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# (URL-encode special characters in the password; allow this machine's IP in Atlas
# under Network Access). Leave empty to save JSON files under DATA_DIR instead.
MONGO_URI=
MONGO_DB=instagram_audience
DATA_DIR=data

# --- What to collect ------------------------------------------------------------
POSTS_PER_INFLUENCER=25
LIKERS_PER_POST=50
COMMENTS_PER_POST=50
# Profile lookups per influencer by audience accounts. 0 = every unique engager.
AUDIENCE_PROFILES_PER_INFLUENCER=0
# Recent posts per engager (1 extra request each). 0 = skip, profile only.
AUDIENCE_RECENT_POSTS=5

# --- Pacing and budgets (per account) ---------------------------------------------
DELAY_MIN=2
DELAY_MAX=6
# MAX_REQUESTS_PER_DAY is each account's ceiling (IG_MAX_PER_DAY_n overrides it per
# account). The warm-up ramp below decides how close to it an account may go today.
MAX_REQUESTS_PER_RUN=2000
MAX_REQUESTS_PER_DAY=1000

# --- Warm-up ramp ---------------------------------------------------------------------
# New accounts start low; the daily limit grows on every day the account actually works
# (used at least half its limit) up to MAX_REQUESTS_PER_DAY / IG_MAX_PER_DAY_n.
# After a block (challenge, action block, repeated please-wait) it drops and climbs again.
# 100 -> 1,000 at +15% takes ~17 working days. See: python -m scraper warmup
WARMUP=on
WARMUP_START_PER_DAY=100
WARMUP_GROWTH_PERCENT=15
WARMUP_DROP_PERCENT=50

# --- Optional daily account activity ------------------------------------------
# Each running worker plans five random, spaced activities per account per day.
# Fill activity.json from activity.example.json and review approved comment text.
# Off by default; the existing worker performs actions only when enabled.
ACTIVITY_ENABLED=off
ACTIVITY_FILE=activity.json

# --- Worker (python -m scraper worker) -----------------------------------------------
# A unique name for THIS server in the shared queue and account locks (default: hostname).
# Each server's .env lists only its own accounts.
WORKER_ID=
# Seconds an idle account waits before checking the queue again.
WORKER_POLL_SECONDS=30

# --- REST API (python -m scraper api) ---------------------------------------------
# If set, every request needs an X-API-Key header.
API_KEY=


# Watch feed Reels in the real Instagram app on a phone/emulator via Appium instead
# (needs: pip install Appium-Python-Client, an Appium 2 server, and devices.json from devices.example.json).
# Watch-only: no review candidates are saved.
ACTIVITY_BROWSER=off
BROWSER_HEADLESS=on
ACTIVITY_MOBILE=on
DEVICES_FILE=devices.json

# Proxy health check interval in minutes (0 = off). A dead or changed proxy IP pauses only that account.
PROXY_CHECK_MINUTES=30
# Days of request traces kept in data/traces (view with: python -m scraper trace).
TRACE_DAYS=14
